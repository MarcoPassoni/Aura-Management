<% if (anomalie && anomalie.length) { %>
  <% anomalie.forEach(function (a) { %>
    <div class="avviso avviso--attenzione" role="alert"><%= a.messaggio %></div>
  <% }); %>
<% } %>

<div class="pannello">
  <div class="pannello__corpo">
    <form method="get" action="/admin/report" class="filtri">
      <div class="campo">
        <label class="campo__etichetta" for="f-da">Dal</label>
        <input type="date" id="f-da" name="da" value="<%= filtri.da %>">
      </div>
      <div class="campo">
        <label class="campo__etichetta" for="f-a">Al</label>
        <input type="date" id="f-a" name="a" value="<%= filtri.a %>">
      </div>
      <button type="submit" class="pulsante pulsante--primario">Filtra</button>
      <a href="/admin/report" class="pulsante">Tutto lo storico</a>
    </form>
  </div>
</div>

<div class="griglia">
  <div class="scheda">
    <div class="scheda__etichetta">Incasso</div>
    <div class="scheda__valore"><%= euro(totali.fatturato) %></div>
    <div class="scheda__nota"><%= numero(totali.tavoli) %> tavoli approvati</div>
  </div>
  <div class="scheda">
    <div class="scheda__etichetta">Provvigioni totali</div>
    <div class="scheda__valore"><%= euro(totali.provvigioni) %></div>
    <div class="scheda__nota">Somma dei guadagni netti di tutti</div>
  </div>
</div>

<div class="avviso avviso--informativo">
  <div>
    <strong>Come si legge.</strong>
    Ogni responsabile riceve la sua percentuale sull'incasso di tutta la propria struttura
    e ne gira una parte ai collaboratori: quello che gli resta e' il <em>guadagno netto</em>.
    La somma dei guadagni netti coincide sempre con il costo totale a carico dell'amministrazione.
  </div>
</div>

<div class="pannello">
  <div class="pannello__testa">
    <h2>Dettaglio per collaboratore</h2>
    <% if (periodoFiltrato) { %>
      <span class="secondario">Periodo filtrato: i saldi non sono mostrati</span>
    <% } %>
  </div>

  <div class="pannello__corpo pannello__corpo--stretto">
    <% if (!elenco.length) { %>
      <div class="vuoto">Nessun dato per il periodo selezionato.</div>
    <% } else { %>
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr>
              <th>Collaboratore</th>
              <th class="num">%</th>
              <th class="num">Incasso proprio</th>
              <th class="num">Incasso struttura</th>
              <th class="num">Maturato lordo</th>
              <th class="num">Gira ai collaboratori</th>
              <th class="num">Guadagno netto</th>
              <% if (!periodoFiltrato) { %>
                <th class="num">Ricevuto</th>
                <th class="num">Da ricevere</th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% elenco.forEach(function (p) { %>
              <tr>
                <td class="<%= rientro(p.livello) %>">
                  <div class="principale"><%= p.nickname %></div>
                  <div class="secondario">
                    <%= p.padreNickname ? 'sotto ' + p.padreNickname : 'primo livello' %>
                  </div>
                </td>
                <td class="num"><%= percentuale(p.percentuale) %></td>
                <td class="num"><%= euro(p.fatturatoDiretto) %></td>
                <td class="num"><%= euro(p.fatturatoSottoalbero) %></td>
                <td class="num"><%= euro(p.maturatoLordo) %></td>
                <td class="num"><%= p.dovutoAiFigli ? euro(p.dovutoAiFigli) : '-' %></td>
                <td class="num principale <%= segno(p.guadagnoNetto) %>"><%= euro(p.guadagnoNetto) %></td>
                <% if (!periodoFiltrato) { %>
                  <td class="num"><%= euro(p.ricevuto) %></td>
                  <td class="num <%= segno(p.saldoDaRicevere) %>"><%= euro(p.saldoDaRicevere) %></td>
                <% } %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
