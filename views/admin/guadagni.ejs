<% if (avvisi && avvisi.length) { %>
  <% avvisi.forEach(function (a) { %>
    <div class="avviso avviso--attenzione" role="alert"><%= a %></div>
  <% }); %>
<% } %>

<div class="pannello">
  <div class="pannello__corpo">
    <form method="get" action="/admin/guadagni" class="filtri">
      <div class="campo">
        <label class="campo__etichetta" for="f-da">Dal</label>
        <input type="date" id="f-da" name="da" value="<%= filtri.da %>">
      </div>
      <div class="campo">
        <label class="campo__etichetta" for="f-a">Al</label>
        <input type="date" id="f-a" name="a" value="<%= filtri.a %>">
      </div>
      <button type="submit" class="pulsante pulsante--primario">Filtra</button>
      <a href="/admin/guadagni" class="pulsante">Tutto lo storico</a>
    </form>
  </div>
</div>

<div class="pannello">
  <div class="pannello__testa">
    <h2>Conto economico</h2>
    <a href="/admin/impostazioni" class="secondario">Modifica quote e detrazioni</a>
  </div>

  <div class="pannello__corpo pannello__corpo--stretto">
    <div class="tabella-contenitore">
      <table>
        <tbody>
          <tr>
            <td class="principale">Incasso dei tavoli</td>
            <td class="secondario">Somma di tutti i tavoli approvati</td>
            <td class="num principale"><%= euro(totali.incassoTotale) %></td>
          </tr>
          <tr>
            <td>Quota del locale</td>
            <td class="secondario"><%= percentuale(impostazioni.quotaLocale) %> dell'incasso</td>
            <td class="num num--negativo">- <%= euro(totali.quotaLocale) %></td>
          </tr>
          <tr>
            <td class="principale">Margine disponibile</td>
            <td class="secondario"><%= percentuale(impostazioni.quotaAdmin) %> dell'incasso</td>
            <td class="num principale"><%= euro(totali.margineLordo) %></td>
          </tr>
          <tr>
            <td>Provvigioni ai collaboratori</td>
            <td class="secondario">
              Calcolate sui <%= numero(totali.numeroCapifila) %> collaboratori di primo livello,
              che le ridistribuiscono lungo la struttura
            </td>
            <td class="num num--negativo">- <%= euro(totali.costoProvvigioni) %></td>
          </tr>
          <tr>
            <td class="principale">Guadagno lordo</td>
            <td></td>
            <td class="num principale <%= segno(totali.guadagnoLordo) %>"><%= euro(totali.guadagnoLordo) %></td>
          </tr>

          <% totali.detrazioni.forEach(function (d) { %>
            <tr>
              <td><%= d.nome %></td>
              <td class="secondario"><%= percentuale(d.percentuale) %> del guadagno lordo</td>
              <td class="num num--negativo">- <%= euro(d.importo) %></td>
            </tr>
          <% }); %>

          <tr>
            <td class="principale">Guadagno netto</td>
            <td class="secondario">Dopo tutte le detrazioni</td>
            <td class="num principale <%= segno(totali.guadagnoNetto) %>"
                style="font-size:1.05rem"><%= euro(totali.guadagnoNetto) %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="pannello">
  <div class="pannello__testa">
    <h2>Contributo per collaboratore</h2>
  </div>
  <div class="pannello__corpo pannello__corpo--stretto">
    <% if (!elenco.length) { %>
      <div class="vuoto">Nessun dato nel periodo selezionato.</div>
    <% } else { %>
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr>
              <th>Collaboratore</th>
              <th class="num">%</th>
              <th class="num">Incasso proprio</th>
              <th class="num">Tavoli</th>
              <th class="num">Persone</th>
              <th class="num">Costa</th>
            </tr>
          </thead>
          <tbody>
            <% elenco.forEach(function (p) { %>
              <tr>
                <td class="<%= rientro(p.livello) %>"><span class="principale"><%= p.nickname %></span></td>
                <td class="num"><%= percentuale(p.percentuale) %></td>
                <td class="num"><%= euro(p.fatturatoDiretto) %></td>
                <td class="num"><%= numero(p.tavoliDiretti) %></td>
                <td class="num"><%= numero(p.personeDirette) %></td>
                <td class="num"><%= euro(p.guadagnoNetto) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="pannello__corpo">
        <p class="secondario" style="margin:0">
          La colonna <em>costa</em> e' il guadagno netto del collaboratore, cioe' la parte
          di provvigione che trattiene per se'. La somma della colonna coincide con le
          provvigioni totali a carico dell'amministrazione.
        </p>
      </div>
    <% } %>
  </div>
</div>
