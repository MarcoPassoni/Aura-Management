<%
  // Funzione ricorsiva per disegnare l'albero. Definita qui e richiamata su
  // ogni ramo: la profondita' e' gia' limitata a monte dal servizio gerarchia.
  function ramo(nodo, radice) {
%>
  <li>
    <div class="albero__nodo <%= radice ? 'albero__nodo--radice' : '' %>">
      <span class="albero__nome"><%= nodo.nickname %></span>
      <span class="pastiglia"><%= percentuale(nodo.percentuale) %></span>
      <% if (!nodo.attivo) { %><span class="stato stato--neutro">Disattivato</span><% } %>
      <% if (nodo.poteri) { %><span class="stato stato--approvato">Delega</span><% } %>
      <span class="albero__dati">
        <span>Struttura <%= euro(nodo.fatturato) %></span>
        <span>Gli resta <%= euro(nodo.trattenuto) %></span>
        <% if (nodo.saldo > 0) { %>
          <span class="num--negativo">Da ricevere <%= euro(nodo.saldo) %></span>
        <% } %>
      </span>
    </div>
    <% if (nodo.figli && nodo.figli.length) { %>
      <ul class="albero">
        <% nodo.figli.forEach(function (f) { ramo(f, false); }); %>
      </ul>
    <% } %>
  </li>
<%
  }
%>

<div class="pannello">
  <div class="pannello__testa">
    <div>
      <h2><%= adminNickname %></h2>
      <div class="secondario">Amministrazione</div>
    </div>
  </div>

  <div class="pannello__corpo">
    <% if (!radici.length) { %>
      <div class="vuoto">
        Nessun collaboratore nella struttura.
        <a href="/admin/staff">Aggiungine uno</a>.
      </div>
    <% } else { %>
      <ul class="albero">
        <% radici.forEach(function (r) { ramo(r, true); }); %>
      </ul>
    <% } %>
  </div>
</div>

<div class="avviso avviso--informativo">
  <div>
    <strong>Struttura</strong> e' l'incasso di quel collaboratore piu' quello di tutti
    i suoi sottoposti. <strong>Gli resta</strong> e' quanto trattiene dopo aver girato
    la quota ai propri collaboratori. <strong>Da ricevere</strong> compare solo quando
    c'e' un saldo ancora aperto.
    L'albero mostra la struttura di oggi; gli importi restano quelli congelati sui
    tavoli quando sono stati approvati.
  </div>
</div>
