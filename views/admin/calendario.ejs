<div class="pannello">
  <div class="pannello__corpo">
    <form method="get" action="/admin/calendario" class="filtri">
      <div class="campo">
        <label class="campo__etichetta" for="mese">Mese</label>
        <input type="month" id="mese" name="mese" value="<%= mese %>">
      </div>
      <button type="submit" class="pulsante pulsante--primario">Mostra</button>
      <a href="/admin/calendario?mese=<%= mesePrecedente %>" class="pulsante"
         aria-label="Mese precedente">&larr; <%= meseIt(mesePrecedente) %></a>
      <a href="/admin/calendario?mese=<%= meseSuccessivo %>" class="pulsante"
         aria-label="Mese successivo"><%= meseIt(meseSuccessivo) %> &rarr;</a>
    </form>
  </div>
</div>

<% if (!giorni.length) { %>
  <div class="pannello">
    <div class="vuoto">Nessun tavolo in <%= meseEstesoIt(mese) %>.</div>
  </div>
<% } else { %>
  <%
    const totaleMese = giorni.reduce(function (s, g) { return s + g.totale; }, 0);
    const tavoliMese = giorni.reduce(function (s, g) { return s + g.tavoli.length; }, 0);
  %>

  <div class="griglia">
    <div class="scheda">
      <div class="scheda__etichetta"><%= meseEstesoIt(mese) %></div>
      <div class="scheda__valore"><%= euro(totaleMese) %></div>
      <div class="scheda__nota">
        <%= numero(tavoliMese) %> tavoli in <%= numero(giorni.length) %> serate.
        L'importo conta solo i tavoli approvati.
      </div>
    </div>
  </div>

  <% giorni.forEach(function (g) { %>
    <div class="pannello">
      <div class="pannello__testa">
        <div>
          <h2><%= dataIt(g.data) %></h2>
          <div class="secondario"><%= numero(g.tavoli.length) %> tavoli</div>
        </div>
        <span class="principale"><%= euro(g.totale) %></span>
      </div>

      <div class="pannello__corpo pannello__corpo--stretto">
        <div class="tabella-contenitore">
          <table>
            <thead>
              <tr>
                <th scope="col">Tavolo</th>
                <th scope="col">Collaboratore</th>
                <th scope="col" class="num">Persone</th>
                <th scope="col" class="num">Imponibile</th>
                <th scope="col">Stato</th>
              </tr>
            </thead>
            <tbody>
              <% g.tavoli.forEach(function (t) { %>
                <tr>
                  <td class="principale"><%= t.nome_tavolo %></td>
                  <td><%= t.pr_nickname %></td>
                  <td class="num"><%= numero(t.numero_persone) %></td>
                  <td class="num">
                    <%= euro(t.imponibile) %>
                    <%- include('../partials/base-calcolo', { tavolo: t }) %>
                  </td>
                  <td><span class="stato <%= classeStato(t.stato) %>"><%= etichettaStato(t.stato) %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% }); %>
<% } %>
