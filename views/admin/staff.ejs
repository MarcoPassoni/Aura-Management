<% if (anomalie && anomalie.length) { %>
  <% anomalie.forEach(function (a) { %>
    <div class="avviso avviso--attenzione" role="alert"><%= a.messaggio %></div>
  <% }); %>
<% } %>

<div class="pannello">
  <div class="pannello__testa">
    <h2>Nuovo collaboratore</h2>
    <button type="button" class="pulsante pulsante--piccolo" data-apre="modulo-nuovo" aria-expanded="false">
      Apri il modulo
    </button>
  </div>

  <div class="pannello__corpo" id="modulo-nuovo" hidden>
    <form method="post" action="/admin/staff/crea" class="modulo" autocomplete="off">
      <div class="modulo modulo--due">
        <div class="campo">
          <label class="campo__etichetta" for="n-nome">Nome</label>
          <input type="text" id="n-nome" name="nome" required maxlength="50">
        </div>
        <div class="campo">
          <label class="campo__etichetta" for="n-cognome">Cognome</label>
          <input type="text" id="n-cognome" name="cognome" required maxlength="50">
        </div>
        <div class="campo">
          <label class="campo__etichetta" for="n-tel">Telefono</label>
          <input type="tel" id="n-tel" name="numero_telefono" required maxlength="20">
        </div>
        <div class="campo">
          <label class="campo__etichetta" for="n-nick">Nickname</label>
          <input type="text" id="n-nick" name="nickname" required maxlength="30" spellcheck="false">
          <span class="campo__aiuto">Serve per accedere. Lettere, numeri, punto, trattino.</span>
        </div>
        <div class="campo">
          <label class="campo__etichetta" for="n-pwd">Password iniziale</label>
          <input type="text" id="n-pwd" name="password" required maxlength="200">
          <span class="campo__aiuto">Almeno 10 caratteri, con una lettera e un numero.</span>
        </div>
        <div class="campo">
          <label class="campo__etichetta" for="n-padre">Responsabile</label>
          <select id="n-padre" name="padre_id" required>
            <% possibiliPadri.forEach(function (p) { %>
              <option value="<%= p.valore %>"><%= p.etichetta %></option>
            <% }); %>
          </select>
          <span class="campo__aiuto">Chi gli paghera' le provvigioni.</span>
        </div>
        <div class="campo">
          <label class="campo__etichetta" for="n-perc">Percentuale provvigione</label>
          <input type="number" id="n-perc" name="percentuale_provvigione"
                 min="0" max="100" step="0.01" value="0" required>
          <span class="campo__aiuto">Non puo' superare quella del responsabile.</span>
        </div>
      </div>

      <div class="campo campo--riga">
        <input type="checkbox" id="n-poteri" name="poteri">
        <label for="n-poteri">Puo' proporre nuovi collaboratori</label>
      </div>

      <div class="azioni">
        <button type="submit" class="pulsante pulsante--primario">Crea collaboratore</button>
      </div>
    </form>
  </div>
</div>

<div class="pannello">
  <div class="pannello__testa">
    <h2>Struttura</h2>
    <span class="secondario"><%= numero(staff.length) %> collaboratori</span>
  </div>

  <div class="pannello__corpo pannello__corpo--stretto">
    <% if (!staff.length) { %>
      <div class="vuoto">Nessun collaboratore. Creane uno con il modulo qui sopra.</div>
    <% } else { %>
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr>
              <th>Collaboratore</th>
              <th>Responsabile</th>
              <th class="num">Percentuale</th>
              <th class="num">Fatturato</th>
              <th class="num">Da ricevere</th>
              <th>Stato</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% staff.forEach(function (p) { %>
              <tr>
                <td class="<%= rientro(p.livello) %>">
                  <div class="principale"><%= p.nickname %></div>
                  <div class="secondario"><%= p.nome %> <%= p.cognome %></div>
                </td>
                <td class="secondario"><%= p.padreNickname || 'Amministratore' %></td>
                <td class="num"><span class="pastiglia"><%= percentuale(p.percentuale) %></span></td>
                <td class="num"><%= euro(p.fatturatoSottoalbero) %></td>
                <td class="num <%= segno(p.saldoDaRicevere) %>"><%= euro(p.saldoDaRicevere) %></td>
                <td>
                  <% if (!p.attivo) { %>
                    <span class="stato stato--neutro">Disattivato</span>
                  <% } else if (p.poteri) { %>
                    <span class="stato stato--approvato">Con delega</span>
                  <% } else { %>
                    <span class="stato stato--neutro">Attivo</span>
                  <% } %>
                </td>
                <td>
                  <button type="button" class="pulsante pulsante--piccolo"
                          data-apre="modifica-<%= p.id %>" aria-expanded="false">Modifica</button>
                </td>
              </tr>

              <tr id="modifica-<%= p.id %>" hidden>
                <td colspan="7" style="background:var(--superficie-alt)">
                  <form method="post" action="/admin/staff/<%= p.id %>/modifica" class="modulo" autocomplete="off">
                    <div class="modulo modulo--due">
                      <div class="campo">
                        <label class="campo__etichetta" for="m-nome-<%= p.id %>">Nome</label>
                        <input type="text" id="m-nome-<%= p.id %>" name="nome" value="<%= p.nome %>" maxlength="50">
                      </div>
                      <div class="campo">
                        <label class="campo__etichetta" for="m-cognome-<%= p.id %>">Cognome</label>
                        <input type="text" id="m-cognome-<%= p.id %>" name="cognome" value="<%= p.cognome %>" maxlength="50">
                      </div>
                      <div class="campo">
                        <label class="campo__etichetta" for="m-tel-<%= p.id %>">Telefono</label>
                        <input type="tel" id="m-tel-<%= p.id %>" name="numero_telefono" value="<%= p.numero_telefono %>" maxlength="20">
                      </div>
                      <div class="campo">
                        <label class="campo__etichetta" for="m-nick-<%= p.id %>">Nickname</label>
                        <input type="text" id="m-nick-<%= p.id %>" name="nickname" value="<%= p.nickname %>" maxlength="30">
                      </div>
                      <div class="campo">
                        <label class="campo__etichetta" for="m-perc-<%= p.id %>">Percentuale</label>
                        <input type="number" id="m-perc-<%= p.id %>" name="percentuale_provvigione"
                               value="<%= p.percentuale %>" min="0" max="100" step="0.01">
                      </div>
                      <div class="campo">
                        <label class="campo__etichetta" for="m-pwd-<%= p.id %>">Nuova password</label>
                        <input type="text" id="m-pwd-<%= p.id %>" name="password" maxlength="200"
                               placeholder="Lascia vuoto per non cambiarla">
                      </div>
                    </div>

                    <div class="campo campo--riga">
                      <input type="checkbox" id="m-poteri-<%= p.id %>" name="poteri" <%= p.poteri ? 'checked' : '' %>>
                      <label for="m-poteri-<%= p.id %>">Puo' proporre nuovi collaboratori</label>
                    </div>

                    <div class="azioni">
                      <button type="submit" class="pulsante pulsante--primario">Salva</button>
                    </div>
                  </form>

                  <div class="azioni" style="margin-top:.75rem">
                    <% if (p.attivo) { %>
                      <form method="post" action="/admin/staff/<%= p.id %>/disattiva"
                            data-conferma="Disattivare <%= p.nickname %>? Non potra' piu' accedere, ma lo storico dei suoi tavoli resta.">
                        <button type="submit" class="pulsante pulsante--pericolo pulsante--piccolo">Disattiva</button>
                      </form>
                    <% } else { %>
                      <form method="post" action="/admin/staff/<%= p.id %>/riattiva">
                        <button type="submit" class="pulsante pulsante--piccolo">Riattiva</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
