<% if (!elenco.length) { %>
  <div class="pannello">
    <div class="vuoto">Nessuna richiesta pronta per l'approvazione.</div>
  </div>
<% } else { %>

  <div class="griglia">
    <div class="scheda">
      <div class="scheda__etichetta">Richieste da valutare</div>
      <div class="scheda__valore"><%= numero(elenco.length) %></div>
    </div>
    <div class="scheda">
      <div class="scheda__etichetta">Imponibile in gioco</div>
      <div class="scheda__valore"><%= euro(totaleImponibile) %></div>
    </div>
    <div class="scheda">
      <div class="scheda__etichetta">Costo se approvi tutto cosi' com'e'</div>
      <div class="scheda__valore"><%= euro(totaleCosto) %></div>
      <div class="scheda__nota">Provvigioni dell'intera catena</div>
    </div>
  </div>

  <% if (bloccati > 0) { %>
    <div class="avviso avviso--errore" role="alert">
      <div>
        <%= numero(bloccati) %>
        <%= bloccati === 1 ? 'richiesta non e\' approvabile' : 'richieste non sono approvabili' %>:
        la catena di responsabilita' del venditore non arriva all'amministrazione.
        Il motivo preciso e' indicato sotto ciascuna.
      </div>
    </div>
  <% } %>

  <div class="avviso avviso--informativo">
    <div>
      Queste richieste sono gia' passate da ogni collaboratore sopra il venditore: ognuno ha
      potuto confermare o correggere la percentuale del proprio sottoposto diretto su questo
      tavolo, ed eventualmente lasciarti un commento. A te resta l'ultimo passaggio: decidere
      (o confermare) la percentuale del capofila e approvare. Nel momento in cui approvi, tutte
      le percentuali della catena vengono <strong>congelate su questo tavolo</strong>: da li' in
      poi cambiarle non tocchera' piu' questo importo. Il rifiuto non cancella la richiesta,
      resta nello storico con il motivo.
    </div>
  </div>

  <% elenco.forEach(function (t) { %>
    <% const r = t.revisione; const ultimo = r.righe.length - 1; %>
    <div class="pannello">
      <div class="pannello__testa">
        <div>
          <h2><%= t.nome_tavolo %></h2>
          <div class="secondario">
            <%= dataIt(t.data) %> &middot; venduto da <%= t.pr_nickname %>
            (<%= percentuale(t.percentuale_provvigione) %> sul suo profilo)
          </div>
        </div>
        <span class="stato stato--attesa">Pronto per te</span>
      </div>

      <div class="pannello__corpo">
        <div class="griglia griglia--compatta">
          <div>
            <div class="scheda__etichetta">Persone</div>
            <div class="principale"><%= numero(t.numero_persone) %></div>
          </div>
          <div>
            <div class="scheda__etichetta">Imponibile</div>
            <div class="principale"><%= euro(t.imponibile) %></div>
            <div class="secondario">
              <%= t.baseCalcolo === 'consuntivo' ? 'incasso reale gia' + ' registrato' : 'spesa prevista' %>
            </div>
          </div>
          <div>
            <div class="scheda__etichetta">Costo provvigioni</div>
            <div class="principale <%= r.ok ? '' : 'num--negativo' %>">
              <%= r.ok ? euro(r.costoTotale) : 'non calcolabile' %>
            </div>
            <div class="secondario">con la percentuale del capofila suggerita</div>
          </div>
          <div>
            <div class="scheda__etichetta">Resta all'amministrazione</div>
            <div class="principale <%= r.ok ? segno(t.imponibile - r.costoTotale) : '' %>">
              <%= r.ok ? euro(t.imponibile - r.costoTotale) : '-' %>
            </div>
            <div class="secondario">prima della quota locale</div>
          </div>
        </div>

        <% if (!r.ok) { %>
          <div class="avviso avviso--errore" role="alert">
            <div>
              <strong>Non approvabile.</strong> <%= r.motivo %>
            </div>
          </div>
        <% } else { %>
          <details class="dettagli" open>
            <summary>Storico della revisione</summary>
            <div class="tabella-contenitore">
              <table>
                <thead>
                  <tr>
                    <th scope="col">Chi</th>
                    <th scope="col" class="num">Percentuale</th>
                    <th scope="col" class="num">Gli spetta</th>
                    <th scope="col" class="num">Gli resta</th>
                    <th scope="col">Deciso da</th>
                    <th scope="col">Commento</th>
                  </tr>
                </thead>
                <tbody>
                  <%# Dal capofila verso il basso: e' l'ordine in cui i soldi scendono. %>
                  <% r.righe.slice().reverse().forEach(function (q) { %>
                    <tr<%= q.livello === ultimo ? ' class="riga--attenuata"' : '' %>>
                      <td class="<%= rientro(ultimo - q.livello) %>">
                        <span class="principale"><%= q.nickname %></span>
                        <% if (q.livello === 0) { %><div class="secondario">venditore</div><% } %>
                        <% if (q.livello === ultimo) { %><div class="secondario">capofila, decidi tu qui sotto</div><% } %>
                      </td>
                      <td class="num">
                        <% if (q.passaggio && q.passaggio.percentuale_decisa !== q.passaggio.percentuale_suggerita) { %>
                          <span class="pastiglia" title="Consigliata: <%= percentuale(q.passaggio.percentuale_suggerita) %>">
                            <%= percentuale(q.percentuale) %>
                          </span>
                        <% } else { %>
                          <%= percentuale(q.percentuale) %>
                        <% } %>
                      </td>
                      <td class="num"><%= euro(q.lordo) %></td>
                      <td class="num principale"><%= euro(q.netto) %></td>
                      <td class="secondario">
                        <% if (q.passaggio) { %>
                          <%= q.passaggio.revisore_nickname %>
                        <% } else { %>
                          in attesa della tua decisione
                        <% } %>
                      </td>
                      <td class="secondario">
                        <%= q.passaggio && q.passaggio.commento ? q.passaggio.commento : '-' %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
                <tfoot>
                  <tr>
                    <th scope="row" colspan="3">Totale a carico dell'amministrazione</th>
                    <td class="num principale"><%= euro(r.costoTotale) %></td>
                    <td colspan="2"></td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </details>
        <% } %>

        <% if (t.omaggi) { %>
          <div class="campo campo--staccato">
            <span class="campo__etichetta">Omaggi</span>
            <div class="secondario"><%= t.omaggi %> <em>(non incide sulle provvigioni)</em></div>
          </div>
        <% } %>

        <% if (t.note_tavolo) { %>
          <div class="campo campo--staccato">
            <span class="campo__etichetta">Note</span>
            <div class="secondario"><%= t.note_tavolo %></div>
          </div>
        <% } %>

        <% if (t.modificata && t.note_modifiche) { %>
          <div class="avviso avviso--attenzione">
            Modificato da <%= t.modificato_da_nickname || 'un amministratore' %>:
            <%= t.note_modifiche %>
          </div>
        <% } %>

        <% if (r.ok) { %>
          <form method="post" action="/admin/approvazioni/<%= t.id %>/approva" class="filtri">
            <%- include('../partials/csrf') %>
            <div class="campo">
              <label class="campo__etichetta" for="cap-<%= t.id %>">
                Percentuale del capofila (<%= r.righe[ultimo].nickname %>)
              </label>
              <input type="number" id="cap-<%= t.id %>" name="percentuale_capofila"
                     min="<%= ultimo > 0 ? r.righe[ultimo - 1].percentuale : 0 %>" max="100" step="0.01"
                     inputmode="decimal" value="<%= r.righe[ultimo].percentuale %>">
              <span class="campo__aiuto">
                Consigliata <%= percentuale(r.righe[ultimo].percentualeProfilo) %> (il suo profilo).
                Solo per questo tavolo.
              </span>
            </div>
            <button type="submit" class="pulsante pulsante--primario">Approva</button>
          </form>
        <% } %>

        <div class="azioni">
          <a href="/admin/approvazioni/<%= t.id %>/modifica" class="pulsante">Correggi i dati</a>
          <button type="button" class="pulsante pulsante--pericolo"
                  data-apre="rifiuta-<%= t.id %>" aria-expanded="false">Rifiuta</button>
        </div>

        <form method="post" action="/admin/approvazioni/<%= t.id %>/rifiuta"
              id="rifiuta-<%= t.id %>" hidden class="modulo modulo--staccato">
          <%- include('../partials/csrf') %>
          <div class="campo">
            <label class="campo__etichetta" for="motivo-<%= t.id %>">Motivo del rifiuto</label>
            <input type="text" id="motivo-<%= t.id %>" name="motivo" maxlength="500"
                   placeholder="Es. data non disponibile" required>
            <span class="campo__aiuto">Il venditore potra' leggerlo nello storico.</span>
          </div>
          <div class="azioni">
            <button type="submit" class="pulsante pulsante--pericolo">Conferma rifiuto</button>
          </div>
        </form>
      </div>
    </div>
  <% }); %>
<% } %>
