<% if (!elenco.length) { %>
  <div class="pannello">
    <div class="vuoto">Nessuna richiesta in attesa. Tutto valutato.</div>
  </div>
<% } else { %>

  <div class="avviso avviso--informativo">
    Un tavolo genera provvigioni solo dopo l'approvazione. Il rifiuto non cancella
    la richiesta: resta consultabile nello storico con il motivo indicato.
  </div>

  <% elenco.forEach(function (t) { %>
    <div class="pannello">
      <div class="pannello__testa">
        <div>
          <h2><%= t.nome_tavolo %></h2>
          <div class="secondario">
            <%= dataIt(t.data) %> &middot; richiesto da <%= t.pr_nickname %>
            (<%= percentuale(t.percentuale_provvigione) %>)
          </div>
        </div>
        <span class="stato stato--attesa">In attesa</span>
      </div>

      <div class="pannello__corpo">
        <div class="griglia" style="margin-bottom:1rem">
          <div>
            <div class="scheda__etichetta">Persone</div>
            <div class="principale"><%= numero(t.numero_persone) %></div>
          </div>
          <div>
            <div class="scheda__etichetta">Spesa prevista</div>
            <div class="principale"><%= euro(t.spesa_prevista) %></div>
          </div>
          <div>
            <div class="scheda__etichetta">Provvigione del richiedente</div>
            <div class="principale"><%= euro(t.spesa_prevista * t.percentuale_provvigione / 100) %></div>
          </div>
        </div>

        <% if (t.omaggi) { %>
          <div class="campo" style="margin-bottom:.75rem">
            <span class="campo__etichetta">Omaggi</span>
            <div class="secondario"><%= t.omaggi %></div>
          </div>
        <% } %>

        <% if (t.note_tavolo) { %>
          <div class="campo" style="margin-bottom:.75rem">
            <span class="campo__etichetta">Note</span>
            <div class="secondario"><%= t.note_tavolo %></div>
          </div>
        <% } %>

        <% if (t.modificata) { %>
          <div class="avviso avviso--attenzione">
            Modificato da <%= t.modificato_da_nickname || 'un amministratore' %>:
            <%= t.note_modifiche %>
          </div>
        <% } %>

        <div class="azioni">
          <form method="post" action="/admin/approvazioni/<%= t.id %>/approva">
            <button type="submit" class="pulsante pulsante--primario">Approva</button>
          </form>

          <a href="/admin/approvazioni/<%= t.id %>/modifica" class="pulsante">Correggi i dati</a>

          <button type="button" class="pulsante pulsante--pericolo"
                  data-apre="rifiuta-<%= t.id %>" aria-expanded="false">Rifiuta</button>
        </div>

        <form method="post" action="/admin/approvazioni/<%= t.id %>/rifiuta"
              id="rifiuta-<%= t.id %>" hidden style="margin-top:.9rem">
          <div class="campo">
            <label class="campo__etichetta" for="motivo-<%= t.id %>">Motivo del rifiuto</label>
            <input type="text" id="motivo-<%= t.id %>" name="motivo" maxlength="500"
                   placeholder="Es. data non disponibile" required>
            <span class="campo__aiuto">Il collaboratore potra' leggerlo nello storico.</span>
          </div>
          <div class="azioni" style="margin-top:.6rem">
            <button type="submit" class="pulsante pulsante--pericolo">Conferma rifiuto</button>
          </div>
        </form>
      </div>
    </div>
  <% }); %>
<% } %>
