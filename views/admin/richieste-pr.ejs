<div class="avviso avviso--informativo">
  Proposte inviate dai collaboratori con delega. Approvando, il profilo viene creato
  con la password che il richiedente ha gia' scelto: l'interessato puo' accedere subito.
</div>

<% if (!elenco.length) { %>
  <div class="pannello">
    <div class="vuoto">Nessuna proposta ricevuta.</div>
  </div>
<% } else { %>
  <% elenco.forEach(function (r) { %>
    <div class="pannello">
      <div class="pannello__testa">
        <div>
          <%# Nome e cognome vengono rimossi dal database non appena la richiesta
              e' decisa (restano solo, cifrati, nel profilo del collaboratore):
              a decisione presa si mostra il nickname, che invece resta sempre. %>
          <h2><% if (r.stato === 'in_attesa') { %><%= r.nome %> <%= r.cognome %><% } else { %><%= r.nickname %><% } %></h2>
          <div class="secondario">
            Proposto da <%= r.richiedente_nickname || 'collaboratore rimosso' %>
            il <%= dataOraIt(r.data_richiesta) %>
          </div>
        </div>
        <span class="stato <%= r.stato === 'approvata' ? 'stato--approvato' : (r.stato === 'rifiutata' ? 'stato--rifiutato' : 'stato--attesa') %>">
          <%= r.stato === 'approvata' ? 'Approvata' : (r.stato === 'rifiutata' ? 'Rifiutata' : 'In attesa') %>
        </span>
      </div>

      <div class="pannello__corpo">
        <div class="griglia griglia--compatta">
          <div>
            <div class="scheda__etichetta">Nickname</div>
            <div class="principale"><%= r.nickname %></div>
          </div>
          <% if (r.stato === 'in_attesa') { %>
            <div>
              <div class="scheda__etichetta">Telefono</div>
              <div class="principale"><%= r.numero_telefono %></div>
            </div>
          <% } %>
          <div>
            <div class="scheda__etichetta">Percentuale richiesta</div>
            <div class="principale"><%= percentuale(r.percentuale_provvigione) %></div>
          </div>
        </div>

        <% if (r.note) { %>
          <div class="campo campo--staccato">
            <span class="campo__etichetta">Note del richiedente</span>
            <div class="secondario"><%= r.note %></div>
          </div>
        <% } %>

        <% if (r.note_admin) { %>
          <div class="campo campo--staccato">
            <span class="campo__etichetta">La tua risposta</span>
            <div class="secondario"><%= r.note_admin %></div>
          </div>
        <% } %>

        <% if (r.stato === 'in_attesa') { %>
          <div class="azioni">
            <form method="post" action="/admin/richieste-pr/<%= r.id %>/approva"
                  data-conferma="Creare il profilo di <%= r.nickname %> al <%= percentuale(r.percentuale_provvigione) %>?">
              <%- include('../partials/csrf') %>
              <button type="submit" class="pulsante pulsante--primario">Approva e crea</button>
            </form>
            <button type="button" class="pulsante pulsante--pericolo"
                    data-apre="rifiuta-pr-<%= r.id %>" aria-expanded="false">Rifiuta</button>
          </div>

          <form method="post" action="/admin/richieste-pr/<%= r.id %>/rifiuta"
                id="rifiuta-pr-<%= r.id %>" hidden class="modulo modulo--staccato">
            <%- include('../partials/csrf') %>
            <div class="campo">
              <label class="campo__etichetta" for="na-<%= r.id %>">Motivo</label>
              <input type="text" id="na-<%= r.id %>" name="note_admin" maxlength="500" required>
            </div>
            <div class="azioni">
              <button type="submit" class="pulsante pulsante--pericolo">Conferma rifiuto</button>
            </div>
          </form>
        <% } else { %>
          <div class="secondario">
            Gestita il <%= dataOraIt(r.data_risposta) %>.
            I dati personali della proposta sono stati rimossi: restano solo nel profilo
            del collaboratore, dove sono cifrati.
          </div>
        <% } %>
      </div>
    </div>
  <% }); %>
<% } %>
