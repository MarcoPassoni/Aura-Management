<div class="griglia">
  <div class="scheda">
    <div class="scheda__etichetta">Da ricevere</div>
    <div class="scheda__valore <%= segno(mia.saldoDaRicevere) %>"><%= euro(mia.saldoDaRicevere) %></div>
    <div class="scheda__nota">Da <%= mia.pagante.nome %></div>
  </div>

  <div class="scheda">
    <div class="scheda__etichetta">Maturato totale</div>
    <div class="scheda__valore"><%= euro(mia.maturatoLordo) %></div>
    <div class="scheda__nota"><%= percentuale(mia.percentuale) %> su <%= euro(mia.fatturatoSottoalbero) %></div>
  </div>

  <div class="scheda">
    <div class="scheda__etichetta">Gia' incassato</div>
    <div class="scheda__valore"><%= euro(mia.ricevuto) %></div>
  </div>

  <% if (figli.length) { %>
    <div class="scheda">
      <div class="scheda__etichetta">Devo ai collaboratori</div>
      <div class="scheda__valore"><%= euro(dovutoAiFigli) %></div>
      <div class="scheda__nota"><%= numero(figli.length) %> collaboratori</div>
    </div>
  <% } else { %>
    <div class="scheda">
      <div class="scheda__etichetta">Tavoli portati</div>
      <div class="scheda__valore"><%= numero(mia.tavoliDiretti) %></div>
      <div class="scheda__nota"><%= numero(mia.personeDirette) %> persone</div>
    </div>
  <% } %>
</div>

<% if (inAttesa > 0) { %>
  <div class="avviso avviso--attenzione">
    Hai <%= numero(inAttesa) %> prenotazioni in attesa di approvazione.
    Non generano provvigioni finche' non vengono approvate.
  </div>
<% } %>

<% if (figli.length) { %>
  <div class="pannello">
    <div class="pannello__testa">
      <h2>La mia struttura</h2>
      <a href="/pr/provvigioni" class="secondario">Gestisci i pagamenti</a>
    </div>
    <div class="pannello__corpo pannello__corpo--stretto">
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr>
              <th>Collaboratore</th>
              <th class="num">%</th>
              <th class="num">Incasso</th>
              <th class="num">Gli devo</th>
            </tr>
          </thead>
          <tbody>
            <% figli.forEach(function (f) { %>
              <tr>
                <td class="principale"><%= f.nickname %></td>
                <td class="num"><%= percentuale(f.percentuale) %></td>
                <td class="num"><%= euro(f.fatturatoSottoalbero) %></td>
                <td class="num <%= segno(f.saldoDaRicevere) %>"><%= euro(f.saldoDaRicevere) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<div class="pannello">
  <div class="pannello__testa">
    <h2>Andamento degli ultimi mesi</h2>
  </div>
  <div class="pannello__corpo">
    <% if (!andamento.length) { %>
      <div class="vuoto">Nessun tavolo approvato negli ultimi mesi.</div>
    <% } else {
         const massimo = Math.max.apply(null, andamento.map(function (m) { return m.fatturato; })) || 1; %>
      <div class="grafico">
        <% andamento.forEach(function (m) { %>
          <div class="grafico__colonna">
            <div class="grafico__valore"><%= numero(Math.round(m.fatturato)) %></div>
            <div class="grafico__barra"
                 style="height: <%= Math.max(2, Math.round((m.fatturato / massimo) * 90)) %>px"
                 title="<%= meseEstesoIt(m.mese) %>: <%= euro(m.fatturato) %>"></div>
            <div class="grafico__etichetta"><%= meseIt(m.mese) %></div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<div class="pannello">
  <div class="pannello__testa">
    <h2>Ultimi tavoli</h2>
    <a href="/pr/tavoli" class="secondario">Vedi tutti</a>
  </div>
  <div class="pannello__corpo pannello__corpo--stretto">
    <% if (!ultimiTavoli.length) { %>
      <div class="vuoto">
        Non hai ancora prenotato tavoli.
        <a href="/pr/prenotazioni">Inserisci il primo</a>.
      </div>
    <% } else { %>
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr>
              <th>Data</th>
              <th>Tavolo</th>
              <th class="num">Persone</th>
              <th class="num">Importo</th>
              <th>Stato</th>
            </tr>
          </thead>
          <tbody>
            <% ultimiTavoli.forEach(function (t) { %>
              <tr>
                <td><%= dataIt(t.data) %></td>
                <td class="principale"><%= t.nome_tavolo %></td>
                <td class="num"><%= numero(t.numero_persone) %></td>
                <td class="num"><%= euro(t.spesa_prevista) %></td>
                <td><span class="stato <%= classeStato(t.stato) %>"><%= etichettaStato(t.stato) %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<% if (pagamentiRicevuti.length) { %>
  <div class="pannello">
    <div class="pannello__testa">
      <h2>Ultimi pagamenti ricevuti</h2>
    </div>
    <div class="pannello__corpo pannello__corpo--stretto">
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr><th>Data</th><th>Da</th><th class="num">Importo</th><th>Note</th></tr>
          </thead>
          <tbody>
            <% pagamentiRicevuti.forEach(function (p) { %>
              <tr>
                <td><%= dataOraIt(p.data_pagamento) %></td>
                <td><%= p.pagante_nickname || 'Amministrazione' %></td>
                <td class="num"><%= euro(p.importo) %></td>
                <td class="secondario"><%= p.note || '-' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>
