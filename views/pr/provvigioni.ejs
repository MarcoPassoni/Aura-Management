<div class="griglia">
  <div class="scheda">
    <div class="scheda__etichetta">Maturato</div>
    <div class="scheda__valore"><%= euro(mia.maturatoLordo) %></div>
    <div class="scheda__nota"><%= percentuale(mia.percentuale) %> su <%= euro(mia.fatturatoSottoalbero) %></div>
  </div>
  <div class="scheda">
    <div class="scheda__etichetta">Ricevuto</div>
    <div class="scheda__valore"><%= euro(mia.ricevuto) %></div>
  </div>
  <div class="scheda">
    <div class="scheda__etichetta">Da ricevere</div>
    <div class="scheda__valore <%= segno(mia.saldoDaRicevere) %>"><%= euro(mia.saldoDaRicevere) %></div>
    <div class="scheda__nota">Da <%= mia.pagante.nome %></div>
  </div>
  <% if (figli.length) { %>
    <div class="scheda">
      <div class="scheda__etichetta">Devo versare</div>
      <div class="scheda__valore"><%= euro(dovutoAiFigli) %></div>
      <div class="scheda__nota">Ai miei collaboratori</div>
    </div>
  <% } %>
</div>

<div class="avviso avviso--informativo">
  Ricevi la tua percentuale sull'incasso di tutta la tua struttura e ne giri una parte
  ai collaboratori. Quello che resta e' il tuo guadagno effettivo:
  <strong><%= euro(mia.guadagnoNetto) %></strong>.
</div>

<% if (figli.length) { %>
  <div class="pannello">
    <div class="pannello__testa">
      <h2>Da versare ai collaboratori</h2>
    </div>
    <div class="pannello__corpo pannello__corpo--stretto">
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr>
              <th>Collaboratore</th>
              <th class="num">%</th>
              <th class="num">Maturato</th>
              <th class="num">Ricevuto</th>
              <th class="num">Da versare</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% figli.forEach(function (f) { %>
              <tr>
                <td class="principale"><%= f.nickname %></td>
                <td class="num"><%= percentuale(f.percentuale) %></td>
                <td class="num"><%= euro(f.maturatoLordo) %></td>
                <td class="num"><%= euro(f.ricevuto) %></td>
                <td class="num principale <%= segno(f.saldoDaRicevere) %>"><%= euro(f.saldoDaRicevere) %></td>
                <td>
                  <% if (f.saldoDaRicevere > 0.01) { %>
                    <button type="button" class="pulsante pulsante--piccolo pulsante--primario"
                            data-apre="paga-<%= f.id %>" aria-expanded="false">Paga</button>
                  <% } else { %>
                    <span class="stato stato--approvato">Saldato</span>
                  <% } %>
                </td>
              </tr>

              <% if (f.saldoDaRicevere > 0.01) { %>
                <tr id="paga-<%= f.id %>" hidden>
                  <td colspan="6" style="background:var(--superficie-alt)">
                    <form method="post" action="/pr/provvigioni/paga" class="modulo">
                      <input type="hidden" name="destinatario_id" value="<%= f.id %>">
                      <div class="filtri">
                        <div class="campo">
                          <label class="campo__etichetta" for="imp-<%= f.id %>">Importo</label>
                          <input type="number" id="imp-<%= f.id %>" name="importo" required
                                 min="0.01" max="<%= f.saldoDaRicevere %>" step="0.01"
                                 value="<%= f.saldoDaRicevere %>">
                          <span class="campo__aiuto">Massimo <%= euro(f.saldoDaRicevere) %></span>
                        </div>
                        <div class="campo" style="flex:2">
                          <label class="campo__etichetta" for="note-<%= f.id %>">Note</label>
                          <input type="text" id="note-<%= f.id %>" name="note" maxlength="500">
                        </div>
                        <button type="submit" class="pulsante pulsante--primario">Registra</button>
                      </div>
                    </form>
                  </td>
                </tr>
              <% } %>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<div class="pannello">
  <div class="pannello__testa">
    <h2>Pagamenti ricevuti</h2>
  </div>
  <div class="pannello__corpo pannello__corpo--stretto">
    <% if (!ricevuti.length) { %>
      <div class="vuoto">Nessun pagamento ricevuto.</div>
    <% } else { %>
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr><th>Data</th><th>Da</th><th class="num">Importo</th><th>Note</th></tr>
          </thead>
          <tbody>
            <% ricevuti.forEach(function (p) { %>
              <tr>
                <td><%= dataOraIt(p.data_pagamento) %></td>
                <td><%= p.pagante_nickname || 'Amministrazione' %></td>
                <td class="num"><%= euro(p.importo) %></td>
                <td class="secondario"><%= p.note || '-' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<% if (versati.length) { %>
  <div class="pannello">
    <div class="pannello__testa">
      <h2>Pagamenti che ho effettuato</h2>
    </div>
    <div class="pannello__corpo pannello__corpo--stretto">
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr><th>Data</th><th>A</th><th class="num">Importo</th><th>Note</th><th></th></tr>
          </thead>
          <tbody>
            <% versati.forEach(function (p) { %>
              <tr>
                <td><%= dataOraIt(p.data_pagamento) %></td>
                <td class="principale"><%= p.destinatario_nickname %></td>
                <td class="num"><%= euro(p.importo) %></td>
                <td class="secondario"><%= p.note || '-' %></td>
                <td>
                  <form method="post" action="/pr/provvigioni/<%= p.id %>/annulla"
                        data-conferma="Annullare questo pagamento di <%= euro(p.importo) %>?">
                    <button type="submit" class="pulsante pulsante--piccolo pulsante--pericolo">Annulla</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>
