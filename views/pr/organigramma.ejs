<%
  function ramo(nodo, radice) {
%>
  <li>
    <div class="albero__nodo <%= radice ? 'albero__nodo--radice' : '' %>">
      <span class="albero__nome"><%= nodo.nickname %><%= radice ? ' (io)' : '' %></span>
      <span class="pastiglia"><%= percentuale(nodo.percentuale) %></span>
      <% if (!nodo.attivo) { %><span class="stato stato--neutro">Disattivato</span><% } %>
      <span class="albero__dati">
        <span>Incasso struttura <%= euro(nodo.fatturato) %></span>
      </span>
    </div>
    <% if (nodo.figli && nodo.figli.length) { %>
      <ul class="albero">
        <% nodo.figli.forEach(function (f) { ramo(f, false); }); %>
      </ul>
    <% } %>
  </li>
<%
  }
%>

<div class="pannello">
  <div class="pannello__testa">
    <div>
      <h2>Il mio responsabile</h2>
      <div class="secondario"><%= responsabile %></div>
    </div>
  </div>

  <div class="pannello__corpo">
    <% if (!radice) { %>
      <div class="vuoto">Struttura non disponibile.</div>
    <% } else { %>
      <ul class="albero">
        <% ramo(radice, true); %>
      </ul>

      <% if (!radice.figli.length) { %>
        <p class="secondario" style="margin-bottom:0">
          Non hai collaboratori sotto di te.
        </p>
      <% } %>
    <% } %>
  </div>
</div>
