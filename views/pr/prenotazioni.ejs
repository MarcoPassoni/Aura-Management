<div class="pannello">
  <div class="pannello__testa">
    <h2>Nuova prenotazione</h2>
  </div>

  <div class="pannello__corpo">
    <form method="post" action="/pr/prenotazioni" class="modulo">
      <%- include('../partials/csrf') %>
      <div class="modulo modulo--due">
        <div class="campo">
          <label class="campo__etichetta" for="data">Data della serata</label>
          <input type="date" id="data" name="data" value="<%= oggi %>" required>
        </div>

        <div class="campo">
          <label class="campo__etichetta" for="nome_tavolo">Tavolo</label>
          <input type="text" id="nome_tavolo" name="nome_tavolo" required maxlength="100"
                 list="tavoli-locale" placeholder="Es. Sala 1 - 3">
          <datalist id="tavoli-locale">
            <% ['Sala 1 - 1','Sala 1 - 2','Sala 1 - 3','Sala 1 - 4','Sala 1 - 5',
                'Sala 1 - 6','Sala 1 - 7','Sala 1 - 8','Sala 1 - 9','Prive - E',
                'Soppalco - 1','Soppalco - 2','Soppalco - 3','Soppalco - 4','Soppalco - 5','Soppalco - 6',
                'Gabbia - 1','Gabbia - 2','Gabbia - 3','Gabbia - 4',
                'Mezza Luna - 1','Mezza Luna - 2',
                'Corridoio - 1','Corridoio - 2','Corridoio - 3','Corridoio - 4'].forEach(function (t) { %>
              <option value="<%= t %>"></option>
            <% }); %>
          </datalist>
          <span class="campo__aiuto">Puoi scegliere dall'elenco o scrivere un nome libero.</span>
        </div>

        <div class="campo">
          <label class="campo__etichetta" for="numero_persone">Numero di persone</label>
          <input type="number" id="numero_persone" name="numero_persone"
                 min="1" max="500" value="2" required inputmode="numeric">
        </div>

        <div class="campo">
          <label class="campo__etichetta" for="spesa_prevista">Spesa prevista</label>
          <input type="number" id="spesa_prevista" name="spesa_prevista"
                 min="0" max="1000000" step="0.01" value="0" required inputmode="decimal">
          <span class="campo__aiuto">
            Su questo importo si calcola la provvigione, finche' l'amministrazione non
            registra l'incasso reale della serata: da quel momento vale quello.
          </span>
        </div>
      </div>

      <div class="campo">
        <label class="campo__etichetta" for="omaggi">Omaggi</label>
        <input type="text" id="omaggi" name="omaggi" maxlength="300"
               placeholder="Facoltativo">
      </div>

      <div class="campo">
        <label class="campo__etichetta" for="note_tavolo">Note</label>
        <textarea id="note_tavolo" name="note_tavolo" maxlength="1000"
                  placeholder="Occasione, richieste particolari, riferimenti"></textarea>
      </div>

      <div class="azioni">
        <button type="submit" class="pulsante pulsante--primario">Invia richiesta</button>
      </div>
    </form>
  </div>
</div>

<div class="pannello">
  <div class="pannello__testa">
    <h2>In attesa di approvazione</h2>
    <span class="secondario">
      <%= numero(elenco.length) %> <%= elenco.length === 1 ? 'richiesta' : 'richieste' %>
    </span>
  </div>

  <div class="pannello__corpo pannello__corpo--stretto">
    <% if (!elenco.length) { %>
      <div class="vuoto">Nessuna richiesta in sospeso.</div>
    <% } else { %>
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr>
              <th>Data</th>
              <th>Tavolo</th>
              <th class="num">Persone</th>
              <th class="num">Importo</th>
              <th>Presso</th>
              <th>Inviata</th>
            </tr>
          </thead>
          <tbody>
            <% elenco.forEach(function (t) { %>
              <tr>
                <td><%= dataIt(t.data) %></td>
                <td class="principale"><%= t.nome_tavolo %></td>
                <td class="num"><%= numero(t.numero_persone) %></td>
                <td class="num"><%= euro(t.spesa_prevista) %></td>
                <td class="secondario"><%= t.revisorePressoChi || '-' %></td>
                <td class="secondario"><%= dataOraIt(t.creato_il) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
