<div class="avviso avviso--informativo">
  La proposta viene valutata dall'amministrazione. Se approvata, il profilo viene creato
  con la password che scegli qui: comunicagliela tu, il sistema non la mostrera' piu'.
</div>

<div class="pannello">
  <div class="pannello__testa">
    <h2>Nuovo collaboratore</h2>
    <span class="secondario">Percentuale massima assegnabile: <%= percentuale(percentualeMassima) %></span>
  </div>

  <div class="pannello__corpo">
    <form method="post" action="/pr/richiesta-nuovo-pr" class="modulo" autocomplete="off">
      <%- include('../partials/csrf') %>
      <div class="modulo modulo--due">
        <div class="campo">
          <label class="campo__etichetta" for="nome">Nome</label>
          <input type="text" id="nome" name="nome" required maxlength="50">
        </div>
        <div class="campo">
          <label class="campo__etichetta" for="cognome">Cognome</label>
          <input type="text" id="cognome" name="cognome" required maxlength="50">
        </div>
        <div class="campo">
          <label class="campo__etichetta" for="tel">Telefono</label>
          <input type="tel" id="tel" name="numero_telefono" required maxlength="20">
        </div>
        <div class="campo">
          <label class="campo__etichetta" for="nick">Nickname</label>
          <input type="text" id="nick" name="nickname" required maxlength="30" spellcheck="false">
        </div>
        <div class="campo">
          <label class="campo__etichetta" for="pwd">Password iniziale</label>
          <input type="text" id="pwd" name="password" required maxlength="200">
          <span class="campo__aiuto">Almeno 10 caratteri, con una lettera e un numero.</span>
        </div>
        <div class="campo">
          <label class="campo__etichetta" for="perc">Percentuale provvigione</label>
          <input type="number" id="perc" name="percentuale_provvigione" required
                 min="0" max="<%= percentualeMassima %>" step="0.01" value="0">
          <span class="campo__aiuto">Non puo' superare la tua.</span>
        </div>
      </div>

      <div class="campo">
        <label class="campo__etichetta" for="padre">Sotto chi lavorera'</label>
        <select id="padre" name="padre_proposto_id" required>
          <% possibiliPadri.forEach(function (p) { %>
            <option value="<%= p.id %>"><%= p.etichetta %> - <%= percentuale(p.percentuale) %></option>
          <% }); %>
        </select>
        <span class="campo__aiuto">Puoi metterlo sotto di te o sotto un tuo collaboratore.</span>
      </div>

      <div class="campo">
        <label class="campo__etichetta" for="note">Note per l'amministrazione</label>
        <textarea id="note" name="note" maxlength="500"
                  placeholder="Perche' proponi questa persona"></textarea>
      </div>

      <div class="azioni">
        <button type="submit" class="pulsante pulsante--primario">Invia proposta</button>
      </div>
    </form>
  </div>
</div>

<div class="pannello">
  <div class="pannello__testa">
    <h2>Le mie proposte</h2>
  </div>

  <div class="pannello__corpo pannello__corpo--stretto">
    <% if (!richieste.length) { %>
      <div class="vuoto">Non hai ancora inviato proposte.</div>
    <% } else { %>
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr>
              <th>Inviata</th>
              <th>Persona</th>
              <th class="num">%</th>
              <th>Stato</th>
              <th>Risposta</th>
            </tr>
          </thead>
          <tbody>
            <% richieste.forEach(function (r) { %>
              <tr>
                <td><%= dataOraIt(r.data_richiesta) %></td>
                <td>
                  <div class="principale"><%= r.nickname %></div>
                  <% if (r.stato === 'in_attesa') { %>
                    <div class="secondario"><%= r.nome %> <%= r.cognome %></div>
                  <% } else { %>
                    <%# Dopo la decisione i dati personali della proposta vengono
                        rimossi: restano solo nel profilo, dove sono cifrati. %>
                    <div class="secondario">dati trasferiti nel profilo</div>
                  <% } %>
                </td>
                <td class="num"><%= percentuale(r.percentuale_provvigione) %></td>
                <td>
                  <span class="stato <%= r.stato === 'approvata' ? 'stato--approvato' : (r.stato === 'rifiutata' ? 'stato--rifiutato' : 'stato--attesa') %>">
                    <%= r.stato === 'approvata' ? 'Approvata' : (r.stato === 'rifiutata' ? 'Rifiutata' : 'In attesa') %>
                  </span>
                </td>
                <td class="secondario"><%= r.note_admin || '-' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
