<div class="pannello">
  <div class="pannello__corpo">
    <form method="get" action="/pr/tavoli" class="filtri">
      <% if (haTeam) { %>
        <div class="campo">
          <label class="campo__etichetta" for="f-ambito">Mostra</label>
          <select id="f-ambito" name="ambito">
            <option value="miei" <%= soloMiei ? 'selected' : '' %>>Solo i miei</option>
            <option value="team" <%= !soloMiei ? 'selected' : '' %>>Tutta la mia struttura</option>
          </select>
        </div>
      <% } %>
      <div class="campo">
        <label class="campo__etichetta" for="f-stato">Stato</label>
        <select id="f-stato" name="stato">
          <option value="">Tutti</option>
          <option value="in_attesa" <%= filtroStato === 'in_attesa' ? 'selected' : '' %>>In attesa</option>
          <option value="approvato" <%= filtroStato === 'approvato' ? 'selected' : '' %>>Approvati</option>
          <option value="rifiutato" <%= filtroStato === 'rifiutato' ? 'selected' : '' %>>Rifiutati</option>
        </select>
      </div>
      <button type="submit" class="pulsante pulsante--primario">Filtra</button>
      <a href="/pr/tavoli" class="pulsante">Azzera</a>
    </form>
  </div>
</div>

<div class="griglia">
  <div class="scheda">
    <div class="scheda__etichetta">Tavoli mostrati</div>
    <div class="scheda__valore"><%= numero(elenco.length) %></div>
  </div>
  <div class="scheda">
    <div class="scheda__etichetta">Incasso approvato</div>
    <div class="scheda__valore"><%= euro(totaleApprovato) %></div>
  </div>
</div>

<div class="pannello">
  <div class="pannello__corpo pannello__corpo--stretto">
    <% if (!elenco.length) { %>
      <div class="vuoto">
        Nessun tavolo trovato.
        <a href="/pr/prenotazioni">Inserisci una prenotazione</a>.
      </div>
    <% } else { %>
      <div class="tabella-contenitore">
        <table>
          <thead>
            <tr>
              <th>Data</th>
              <th>Tavolo</th>
              <% if (!soloMiei) { %><th>Collaboratore</th><% } %>
              <th class="num">Persone</th>
              <th class="num">Importo</th>
              <th>Stato</th>
            </tr>
          </thead>
          <tbody>
            <% elenco.forEach(function (t) { %>
              <tr>
                <td><%= dataIt(t.data) %></td>
                <td>
                  <div class="principale"><%= t.nome_tavolo %></div>
                  <% if (t.modificata) { %>
                    <div class="secondario">
                      Modificato da <%= t.modificato_da_nickname || 'amministrazione' %>:
                      <%= t.note_modifiche %>
                    </div>
                  <% } %>
                  <% if (t.stato === 'rifiutato' && t.motivo_rifiuto) { %>
                    <div class="secondario">Motivo: <%= t.motivo_rifiuto %></div>
                  <% } %>
                </td>
                <% if (!soloMiei) { %><td><%= t.pr_nickname %></td><% } %>
                <td class="num"><%= numero(t.numero_persone) %></td>
                <td class="num"><%= euro(t.spesa_prevista) %></td>
                <td><span class="stato <%= classeStato(t.stato) %>"><%= etichettaStato(t.stato) %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
