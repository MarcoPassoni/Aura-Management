<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Accedi - Aura</title>
  <link rel="icon" type="image/x-icon" href="/img/favicon.ico">
  <link rel="stylesheet" href="/css/aura.css">
</head>
<body>
  <main class="accesso">
    <div class="accesso__riquadro">
      <div class="accesso__marchio">
        <div class="accesso__nome">AUR<span>A</span></div>
        <div class="accesso__sotto">Gestione staff e prenotazioni</div>
      </div>

      <% if (errore) { %>
        <div class="avviso avviso--errore" role="alert"><%= errore %></div>
      <% } %>
      <% if (messaggio) { %>
        <div class="avviso avviso--ok" role="status"><%= messaggio %></div>
      <% } %>

      <form method="post" action="/login" class="modulo" autocomplete="on">
        <div class="campo">
          <label class="campo__etichetta" for="nickname">Nickname</label>
          <input type="text" id="nickname" name="nickname" required autofocus
                 autocomplete="username" maxlength="30" spellcheck="false">
        </div>

        <div class="campo">
          <label class="campo__etichetta" for="password">Password</label>
          <input type="password" id="password" name="password" required
                 autocomplete="current-password" maxlength="200">
        </div>

        <button type="submit" class="pulsante pulsante--primario pulsante--largo">Accedi</button>
      </form>
    </div>
  </main>
</body>
</html>
